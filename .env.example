# -----------------------------------------------------------------------------
# University Study Platform — Environment Variables Template
# -----------------------------------------------------------------------------

# Supabase Public Configuration (Accessible in client and server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Server-Only Secret (NEVER expose in client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PostgreSQL Database Connection (Prisma)
# Transactional connection pooler URL (e.g. Supabase port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL for migrations (e.g. Supabase port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# App Base URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
